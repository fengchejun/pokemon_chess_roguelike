extends RefCounted


func run(t: TestContext) -> void:
	t.begin("营地与节点实际流程")
	var app = load("res://scripts/main.gd").new()
	app.autosave_enabled = false
	t.tree.root.add_child(app)
	app.begin_new_run_with_collection(CollectionState.defaults().select_records([1, 2, 3]))
	var theme := String(app.run.offered_floor_themes[0])
	app.current_screen.find_child("ChooseTheme_" + theme, true, false).pressed.emit()
	t.eq(app.current_screen.name, "RegionScreen", "选择主题直接进入大地图")
	t.eq(app.run.get_region().visits, 0, "初始营地不计移动")
	var camp_path := "res://.test_region_camp.json"
	SaveSystem.save_run(app.run, camp_path)
	app.show_menu()
	app.continue_run(camp_path)
	t.eq(app.current_screen.name, "RegionScreen", "初始地图读档仍回大地图")
	app.enter_region_node("camp")
	t.eq(app.current_screen.name, "CampScreen", "主动点击营地进入营地场景")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(camp_path))
	var affinity_before := int(app.run.carried[0].get("affinity", 0))
	app.current_screen._show_monster(1)
	var interaction: PopupMenu = app.current_screen.find_child("CampInteraction_1", true, false)
	t.check(interaction != null, "点击宝可梦打开互动选项")
	interaction.id_pressed.emit(0)
	t.check(String(app.current_screen.find_child("CampFeedback", true, false).text).contains("抚摸"), "互动立即显示回应")
	t.eq(app.run.carried[0]["affinity"], affinity_before, "互动不增加亲密度")
	app.run.trainer_hp = 1
	app.run.carried[0]["hp"] = 0
	var fire: Button = app.current_screen.find_child("Campfire", true, false)
	t.check(fire != null, "独立营地有可点击篝火")
	fire.pressed.emit()
	var rest: Button = app.current_screen.find_child("CampRestButton", true, false)
	t.check(rest != null and not rest.disabled, "库存足够且需恢复时可休息")
	rest.pressed.emit()
	t.eq(app.run.food_inventory["basic"], 0, "篝火按类型扣除食物")
	t.eq(app.run.carried[0]["hp"], ceili(app.run.monster_max_hp(app.run.carried[0]) / 2.0), "篝火将濒死成员恢复至半血")
	app.run.trainer_hp = 1
	app.show_camp()
	app.current_screen.find_child("Campfire", true, false).pressed.emit()
	var empty_rest: Button = app.current_screen.find_child("CampRestButton", true, false)
	t.check(empty_rest.disabled and String(app.current_screen.find_child("CampRestHint", true, false).text).contains("不足"), "库存不足时禁用并说明原因")
	app.leave_camp()
	t.eq(app.current_screen.name, "RegionScreen", "营地返回区域路线")
	t.eq(app.run.get_region().visits, 1, "主动访问营地计一次移动")
	var route_path := "res://.test_region_route.json"
	SaveSystem.save_run(app.run, route_path)
	app.show_menu()
	app.continue_run(route_path)
	t.eq(app.current_screen.name, "RegionScreen", "从路线存档继续不会重复打开初始营地")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(route_path))
	app.enter_region_node("event_1")
	t.eq(app.run.get_region().visits, 2, "确认进入收集区再计一次移动")
	app.run.reward_inventory.append(RewardDB.MOD_ITEM)
	t.check(app.run.use_reward_item_in_preview(RewardDB.MOD_ITEM), "预览中可先使用改造道具")
	app.run.preview_modifications.append({"x": 4, "y": 4, "kind": "water"})
	app.cancel_region_entry()
	t.eq(app.run.get_region().visits, 1, "预览前取消进入回退计数")
	t.check(app.run.reward_inventory.has(RewardDB.MOD_ITEM) and app.run.preview_used_reward_item == "" and app.run.preview_modifications.is_empty(), "取消进入退还未开战道具并清理预览改造")
	app.enter_region_node("event_1")
	app.show_preview([1, 2, 3])
	app.current_screen._on_start()
	var event = app.current_screen
	t.eq(event.state.node_kind, "event", "原生收集区进入普通行动模式")
	t.eq(event.state.alive_enemy_count(), 0, "收集区没有敌军")
	t.check(not event.state.nest["alive"], "收集区巢穴关闭")
	event.state.end_battle("explored")
	app.finish_battle(event.state)
	app.continue_after_settlement()
	t.eq(app.current_screen.name, "RegionScreen", "主动离开收集区回到路线")
	app.enter_region_node("battle_1")
	app.show_preview([1, 2, 3])
	app.current_screen._on_start()
	var combat = app.current_screen
	t.eq(combat.state.alive_enemy_count(), 3, "普通战斗初始驻军恰为 3 名")
	var foe: CombatUnit = combat.state.alive_units("enemy")[0]
	foe.hp -= 2
	var foe_uid := foe.uid
	var foe_cell := foe.cell
	combat.state.round = 8
	combat.state.end_enemy_phase()
	t.check(not combat.state.ended and not combat.state.storm_strikes.is_empty(), "普通战斗第8回合继续并预告落雷")
	combat.state.end_battle("escape")
	app.finish_battle(combat.state)
	app.continue_after_settlement()
	app.enter_region_node("battle_1")
	app.show_preview([1, 2, 3])
	app.current_screen._on_start()
	var revisit = app.current_screen
	t.eq(revisit.state.alive_enemy_count(), 4, "重访补足固定 4 名")
	t.eq(revisit.state.unit_by_uid(foe_uid).hp, revisit.state.unit_by_uid(foe_uid).max_hp, "旧存活敌人回满")
	t.eq(revisit.state.unit_by_uid(foe_uid).cell, foe_cell, "旧敌人位置保留")
	t.eq(revisit.state.round, 1, "重访重开第一回合")
	var path := "res://.test_region_resume.json"
	app.sync_and_save(revisit.state)
	t.check(SaveSystem.save_run(app.run, path), "保存进行中战斗")
	app.show_menu()
	app.continue_run(path)
	t.eq(app.current_screen.name, "BattleScreen", "标题续战恢复进行中战斗")
	t.eq(app.current_screen.state.alive_enemy_count(), 4, "补兵状态读档不重复补充")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	var camp_run := RunState.new_run(915)
	camp_run.region_mode = true
	camp_run.choose_floor_theme(String(camp_run.offered_floor_themes[0]))
	camp_run.enter_region_node("camp")
	var starting_count := camp_run.carried.size()
	for i in range(Balance.CARRIED_LIMIT + 20):
		camp_run._add_capture("fire_starter", 10)
	t.eq(camp_run.storage.size(), starting_count + 20, "满员捕获可无限存放在营地")
	var before_uid := int(camp_run.carried[0]["uid"])
	var stored_uid := int(camp_run.storage[0]["uid"])
	t.check(camp_run.camp_swap(before_uid, stored_uid), "营地内可交换成员")
	t.eq(int(camp_run.carried[0]["uid"]), stored_uid, "交换后成员进入背包")
	var outside = camp_run.get_region()
	outside.at_camp_scene = false
	camp_run.region_data = outside.to_dict()
	t.check(not camp_run.camp_swap(stored_uid, before_uid), "离开营地后不能交换")
	var collection := CollectionState.defaults()
	collection.absorb_run(camp_run)
	t.check(collection.owned.all(func(entry): return String(entry.get("source", "")) != "run:915:%d" % before_uid), "留守成员不登记永久收藏")
	app.queue_free()
	t.finish()
