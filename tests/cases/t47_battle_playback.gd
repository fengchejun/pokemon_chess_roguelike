extends RefCounted

func run(t: TestContext) -> void:
	t.begin("逐次播放、展示隔离与速度")
	var app = load("res://scripts/main.gd").new()
	app.autosave_enabled = false
	t.tree.root.add_child(app)
	app.run = RunState.new_run(42)
	var screen = load("res://scripts/ui/battle_screen.gd").new()
	screen.state = TestScenario.make_state(["fire_starter", "water_starter", "grass_starter"], [["grass_wild1", Vector2i(4, 3)], ["rock_wild1", Vector2i(6, 5)]])
	app._switch(screen)
	var state: BattleState = screen.state
	var caster := state.unit_by_uid(1)
	caster.cell = Vector2i(1, 3)
	if not caster.skills.has("fire_seed"):
		caster.skills.append("fire_seed")
	state.unit_by_uid(2).cell = Vector2i(0, 5)
	state.unit_by_uid(3).cell = Vector2i(0, 6)
	var target := state.unit_by_uid(100)
	target.element = "grass"
	var entry := {"type": "cell", "cell": target.cell}
	screen.refresh_all()
	var clone := state.clone()
	var old_hp := target.hp
	var signature := state._signature()
	state.preview_skill(caster, "fire_seed", entry)
	t.check(not screen.playback.active(), "预览不进入实战展示队列")
	t.eq(state._signature(), signature, "预览保留战斗状态")
	var result := state.cast_skill(caster, "fire_seed", entry)
	var baseline := clone.cast_skill(clone.unit_by_uid(1), "fire_seed", entry)
	t.check(result["ok"] and baseline["ok"], "两份战场都施法成功")
	t.eq(JSON.stringify(BattleSnapshot.save_state(state)), JSON.stringify(BattleSnapshot.save_state(clone)), "有无展示录制的规则结果、随机数和存档完全一致")
	t.eq(screen.playback.queue.size(), 1, "一个技能形成一项完整展示记录")
	screen.playback.advance(0.2)
	t.eq(screen.board.units.filter(func(u): return u.uid == target.uid)[0].hp, old_hp, "起手阶段展示旧血量")
	t.check(screen.skill_banner.caption.text.contains("使用了火种"), "顶部横幅绑定当前动作")
	screen.playback.advance(0.29)
	t.eq(screen.board.units.filter(func(u): return u.uid == target.uid)[0].hp, old_hp, "投射物飞行阶段不提前扣血")
	t.check(screen.feedback_layer.entries.is_empty(), "命中前不显示伤害与属性飘字")
	screen.playback.advance(0.02)
	t.eq(screen.board.units.filter(func(u): return u.uid == target.uid)[0].hp, target.hp, "命中节点展示实际血量")
	t.check(not screen.feedback_layer.entries.is_empty(), "命中节点释放飘字")
	var recorded := state._signature()
	t.check(not screen.do_cast("fire_seed", entry), "播放时不接受新的施法")
	t.check(not screen.do_move(Vector2i(2, 3)), "播放时不接受新的移动")
	t.check(not screen.do_undo(), "播放时不接受撤回")
	t.eq(state._signature(), recorded, "被阻止的操作不改变规则")
	screen._open_menu()
	var clock: float = screen.playback.elapsed
	screen.playback._process(0.2)
	t.approx(screen.playback.elapsed, clock, "菜单暂停播放")
	screen._close_modal()
	screen._toggle_speed()
	t.eq(app.battle_playback_speed, 2.0, "切换为2倍速")
	screen.playback._process(0.1)
	t.approx(screen.playback.elapsed, clock + 0.2, "2倍速统一推进动画时钟")
	screen.playback.finish_all()
	t.check(not screen.playback.active(), "完整播放后队列排空")
	t.eq(state._signature(), recorded, "播放完毕没有重复执行技能")
	t.check(not screen.skill_banner.visible, "播放完毕横幅隐藏")
	# Two releases resolved synchronously must remain separate visual actions.
	var second := state.unit_by_uid(2)
	var third := state.unit_by_uid(3)
	state.feedback_enabled = false
	second.cell = Vector2i(1, 4)
	third.cell = Vector2i(1, 5)
	state.feedback_enabled = true
	SkillResolver.resolve_channel(state, second, "rock_slide", [Vector2i(6, 5)])
	SkillResolver.resolve_channel(state, third, "fire_burst", [Vector2i(6, 5)])
	t.eq(screen.playback.queue.size(), 2, "连续蓄力结算分为两项行动")
	screen.playback.advance(0.2)
	t.check(screen.skill_banner.caption.text.contains(SkillDB.name_of("rock_slide")), "第一项技能先显示")
	screen.playback.advance(0.9)
	screen.playback.advance(0.01)
	t.check(screen.skill_banner.caption.text.contains(SkillDB.name_of("fire_burst")), "第二项技能随后显示")
	screen.playback.finish_all()
	state.damage_unit(null, state.trainer(), 1, {"no_element": true})
	state.emit_feedback(state.trainer(), "status", "测试状态")
	t.eq(screen.playback.queue[1]["before"].trainer().hp, screen.playback.queue[0]["after"].trainer().hp, "连续独立反馈以前一项结果为起点，不恢复旧血量")
	screen.playback.finish_all()
	target.cell = Vector2i(2, 3)
	target.hp = 999
	state.set_terrain(Vector2i(3, 3), TerrainDB.OBSTACLE)
	state.obstacle_durability[Vector2i(3, 3)] = 3
	SkillResolver.apply(state, caster, "rock_push", {"type": "unit", "unit": target.uid, "cell": target.cell}, false)
	screen.playback.advance(0.51)
	var damage_steps: Array = screen.playback.steps.filter(func(s): return s["event"]["kind"] == "damage" and s["event"]["uid"] == target.uid)
	t.eq(damage_steps.size(), 2, "普通命中与碰撞分别记录")
	t.check(damage_steps[1]["time"] > damage_steps[0]["time"], "同格碰撞晚于首次命中展示")
	t.check(screen.playback.visual.unit_by_uid(target.uid).hp > target.hp, "首次命中不提前显示碰撞后的最终血量")
	screen.playback.finish_all()
	target.cell = Vector2i(4, 3)
	state.set_terrain(Vector2i(3, 3), TerrainDB.PLAIN)
	state.obstacle_durability.erase(Vector2i(3, 3))
	var victim := state.unit_by_uid(101)
	victim.hp = 20
	state.set_terrain(victim.cell, TerrainDB.PIT)
	state.kill_unit(victim, "坠落演出", "player", caster.uid)
	screen.playback.advance(0.05)
	t.check(not screen.playback.visual.unit_by_uid(victim.uid).is_alive(), "直接坠落在提示出现时移除存活身体，由离场效果接续")
	screen.playback.finish_all()
	var saved := BattleSnapshot.save_state(state)
	var loaded := BattleSnapshot.load_state(saved)
	t.check(not loaded.feedback_enabled, "存档不恢复录制器或播放队列")
	var next = load("res://scripts/ui/battle_screen.gd").new()
	next.state = loaded
	SkillResolver.apply(state, caster, "fire_seed", entry, false)
	t.check(screen.playback.active(), "离开时允许取消尚未播放的展示")
	var before_leave := state._signature()
	app._switch(next)
	t.eq(state._signature(), before_leave, "离开界面不重复结算或回滚行动")
	t.check(not next.playback.active(), "读档后不重播旧动画")
	t.eq(app.battle_playback_speed, 2.0, "速度在同次程序的后续战斗保留")
	t.eq(next.speed_button.text, "速度：2×", "速度按钮显示正确")
	app.queue_free()
	t.finish()
