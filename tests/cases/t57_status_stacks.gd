extends RefCounted

func run(t: TestContext) -> void:
	t.begin("合并异常：整轮结算、刷新持续与水格净化")
	var state := TestScenario.make_state(["grass_starter"], [["grass_wild1", Vector2i(6, 6)]])
	var player := state.unit_by_uid(1)
	var enemy := state.unit_by_uid(100)
	state.apply_burn(player, enemy)
	state.apply_burn(enemy, player)
	state.apply_burn(player, enemy)
	t.eq(player.burn_ticks, Balance.BURN_TICKS, "重复灼烧刷新持续时间")
	var hp: int = player.hp
	state._finish_status_effects("player")
	t.eq(player.hp, hp, "单方阶段不结算周期伤害")
	state.settle_round()
	t.eq(player.hp, hp - Balance.burn_damage_for(player.max_hp), "整轮只结算一次百分比灼烧")
	t.eq(player.burn_ticks, 1, "整轮衰减一次")
	state.set_terrain(Vector2i(2, 3), TerrainDB.WATER)
	player.cell = Vector2i(2, 3)
	state.settle_round()
	t.eq(player.burn_ticks, 0, "整轮站水上净化灼烧")
	t.eq(player.hp, hp - Balance.burn_damage_for(player.max_hp), "净化先于周期伤害")
	var cloned := BattleSnapshot.load_state(BattleSnapshot.save_state(state)).clone()
	t.eq(cloned._signature(), state._signature(), "新异常记录克隆存读档一致")
	t.finish()
