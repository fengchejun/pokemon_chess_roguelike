[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/board_preview.gd" id="1"]
[ext_resource type="Script" path="res://scripts/board_grid.gd" id="2"]

[node name="BoardPreview" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.082, 0.129, 0.153, 1)

[node name="Layout" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24

[node name="Column" type="VBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Layout/Column"]
layout_mode = 2

[node name="Title" type="Label" parent="Layout/Column/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 30
text = "8×8 棋盘预览"

[node name="BackButton" type="Button" parent="Layout/Column/Header"]
custom_minimum_size = Vector2(150, 44)
layout_mode = 2
text = "返回菜单"

[node name="BoardCenter" type="CenterContainer" parent="Layout/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="BoardGrid" type="Control" parent="Layout/Column/BoardCenter"]
custom_minimum_size = Vector2(512, 512)
layout_mode = 2
mouse_filter = 2
script = ExtResource("2")

[node name="Hint" type="Label" parent="Layout/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "当前仅展示棋盘。单位、行动与战斗规则将在后续阶段加入。"
horizontal_alignment = 1

[connection signal="pressed" from="Layout/Column/Header/BackButton" to="." method="_on_back_pressed"]
